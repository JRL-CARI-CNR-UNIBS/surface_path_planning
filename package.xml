  <maintainer email="manuel.beschi@unibs.it">Manuel Beschi (CARI-JRL)</maintainer>
  <license>Apache-2.0</license>
  <author email="manuel.beschi@unibs.it">Manuel Beschi</author>
  <author>Elisa Zappa</author>

  <depend>moveit_collision_checker</depend>
  <buildtool_depend>ament_cmake</buildtool_depend>
  <buildtool_depend>ur_ik_solver</buildtool_depend>
  <buildtool_depend>moveit_msgs</buildtool_depend>
  <depend>visualization_msgs</depend>
  <depend>moveit_visual_tools</depend>
  <depend>tf2_eigen</depend>
  <depend>graph_core</depend>
  <depend>graph_display</depend>
  <depend>urdfdom</depend>
  <depend>ik_solver</depend>
  <depend>ur_ik_solver</depend>
  <depend>ik_solver_core</depend>
  <depend>moveit_core</depend>
  <depend>rclpy</depend>
  <depend>ament_cmake_python</depend>

  <buildtool_depend>rosidl_default_generators</buildtool_depend>
  <depend>control_msgs</depend>
  <depend>rclcpp</depend>
  <depend>rclcpp_action</depend>
  <depend>ament_index_cpp</depend>
  <depend>sensor_msgs</depend>
  <depend>trajectory_msgs</depend>
  <depend>geometry_msgs</depend>
  <depend>moveit_msgs</depend>
  <depend version_gte="0.1.0">ik_solver_msgs</depend>
  <depend>surface_path_planning_msgs</depend>
  <depend>parallel_multigoal_planner_msgs</depend>
  <exec_depend>parallel_multigoal_planner</exec_depend>
  <exec_depend>collision_checker_server</exec_depend>
  <exec_depend>surface_raster_planner_msgs</exec_depend>
  <exec_depend>time_parametrization</exec_depend>
  <exec_depend>time_parametrization_msgs</exec_depend>

  <test_depend>ament_lint_auto</test_depend>
  <test_depend>ament_lint_common</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
